{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "customTemplates": [
    {
      "name": "blank",
      "title": "Blank",
      "postTypes": [
        "page",
        "post"
      ]
    },
    {
      "name": "page-no-title",
      "title": "Page (No Title)",
      "postTypes": [
        "page"
      ]
    }
  ],
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": true,
      "customDuotone": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "color": "#ffffff",
          "name": "Base",
          "slug": "base"
        },
        {
          "color": "#000000",
          "name": "Contrast",
          "slug": "contrast"
        },
        {
          "color": "#899499",
          "name": "Primary",
          "slug": "primary"
        },
        {
          "color": "#36454F",
          "name": "Secondary",
          "slug": "secondary"
        },
        {
          "color": "#E5E4E2",
          "name": "Tertiary",
          "slug": "tertiary"
        }
      ]
    },
    "custom": {
      "lineHeight": {
        "large": "2.2",
        "medium": "1.8",
        "small": "1.5",
        "x-large": "2.6"
      },
      "outline": {
        "width": "2px",
        "offset": "2px",
        "style": "solid"
      }
    },
    "layout": {
      "contentSize": "840px",
      "wideSize": "1200px"
    },
    "border": {
      "radius": true,
      "radiusSizes": [
        {
          "name": "XS",
          "slug": "xs",
          "size": "0.125rem"
        },
        {
          "name": "Small",
          "slug": "sm",
          "size": "0.25rem"
        },
        {
          "name": "Medium",
          "slug": "md",
          "size": "0.375rem"
        },
        {
          "name": "Large",
          "slug": "lg",
          "size": "0.5rem"
        },
        {
          "name": "XL",
          "slug": "xl",
          "size": "0.75rem"
        },
        {
          "name": "2XL",
          "slug": "2-xl",
          "size": "1rem"
        },
        {
          "name": "3XL",
          "slug": "3-xl",
          "size": "1.5rem"
        }
      ]
    },
    "spacing": {
      "spacingScale": {
        "steps": 0
      },
      "spacingSizes": [
        {
          "size": "1rem",
          "slug": "30",
          "name": "Small"
        },
        {
          "size": "clamp(1rem, 4vw, 2rem)",
          "slug": "40",
          "name": "Medium"
        },
        {
          "size": "clamp(2rem, 8vw, 4rem)",
          "slug": "50",
          "name": "Large"
        },
        {
          "size": "clamp(4rem, 10vw, 8rem)",
          "slug": "60",
          "name": "Huge"
        }
      ],
      "units": [
        "%",
        "px",
        "em",
        "rem",
        "vh",
        "vw"
      ]
    },
    "typography": {
      "customFontSize": true,
      "defaultFontSizes": false,
      "dropCap": true,
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "\"Courier New\", Courier, \"Lucida Sans Typewriter\", \"Lucida Typewriter\", monospace",
          "slug": "courier-new"
        },
        {
          "fontFamily": "Arial, \"Helvetica Neue\", Helvetica, sans-serif",
          "slug": "arial-helvetica"
        }
      ],
      "fontSizes": [
        {
          "fluid": false,
          "size": "0.8rem",
          "slug": "small"
        },
        {
          "fluid": false,
          "size": "1rem",
          "slug": "base"
        },
        {
          "fluid": {
            "min": "1.25rem",
            "max": "1.42rem"
          },
          "size": "1.42rem",
          "slug": "medium"
        },
        {
          "fluid": {
            "min": "1.56rem",
            "max": "1.89rem"
          },
          "size": "1.89rem",
          "slug": "large"
        },
        {
          "fluid": {
            "min": "1.95rem",
            "max": "2.52rem"
          },
          "size": "2.52rem",
          "slug": "x-large"
        },
        {
          "fluid": {
            "min": "2.44rem",
            "max": "3.35rem"
          },
          "size": "3.35rem",
          "slug": "xx-large"
        }
      ],
      "fontStyle": true,
      "fontWeight": true,
      "textDecoration": true,
      "textTransform": true
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "spacing": {
      "blockGap": "1rem",
      "padding": {
        "top": "var(--wp--preset--spacing--30)",
        "right": "var(--wp--preset--spacing--30)",
        "bottom": "var(--wp--preset--spacing--30)",
        "left": "var(--wp--preset--spacing--30)"
      }
    },
    "typography": {
      "fontSize": "var(--wp--preset--font-size--base)",
      "fontFamily": "var(--wp--preset--font-family--courier-new)",
      "lineHeight": "1.6"
    },
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "blocks": {
      "core/columns": {
        "spacing": {
          "blockGap": "var:preset|spacing|50"
        }
      },
      "core/buttons": {
        "spacing": {
          "blockGap": "var:preset|spacing|40"
        }
      },
      "core/site-title": {
        "elements": {
          "link": {
            "color": {
              "text": "var(--wp--preset--color--contrast)"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)",
          "fontFamily": "var(--wp--preset--font-family--arial-helvetica)",
          "fontWeight": "700"
        }
      },
      "core/post-title": {
        "elements": {
          "link": {
            "color": {
              "text": "var(--wp--preset--color--contrast)"
            }
          }
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)",
          "fontFamily": "var(--wp--preset--font-family--arial-helvetica)",
          "fontWeight": "700"
        }
      },
      "core/navigation": {
        "elements": {
          "link": {
            ":hover": {
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      },
      "core/site-tagline": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)"
        }
      },
      "core/separator": {
        "border": {
          "color": "currentColor",
          "style": "solid",
          "width": "0 0 1px 0"
        },
        "color": {
          "text": "var(--wp--preset--color--contrast-medium)"
        }
      },
      "core/list": {
        "css": "& li { margin-top: 0.5rem; }"
      }
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--arial-helvetica)",
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--arial-helvetica)",
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--arial-helvetica)",
          "fontSize": "var(--wp--preset--font-size--large)"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--arial-helvetica)",
          "fontSize": "var(--wp--preset--font-size--medium)"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--arial-helvetica)",
          "fontSize": "var(--wp--preset--font-size--base)"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--arial-helvetica)",
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      },
      "heading": {
        "typography": {
          "lineHeight": "1.4"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--secondary)"
        },
        ":hover": {
          "typography": {
            "textDecoration": "none"
          }
        },
        ":focus": {
          "typography": {
            "textDecoration": "underline dashed"
          }
        },
        ":active": {
          "color": {
            "text": "var(--wp--preset--color--secondary)"
          },
          "typography": {
            "textDecoration": "none"
          }
        },
        "typography": {
          "textDecoration": "underline"
        }
      },
      "button": {
        "spacing": {
          "padding": {
            "top": "12px",
            "right": "20px",
            "bottom": "12px",
            "left": "20px"
          }
        },
        "border": {
          "width": "0",
          "radius": "0px",
          "style": "solid",
          "color": "var(--wp--preset--color--contrast)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--arial-helvetica)",
          "fontWeight": "700"
        },
        "color": {
          "background": "var(--wp--preset--color--secondary)",
          "text": "var(--wp--preset--color--contrast)"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--contrast)",
            "text": "var(--wp--preset--color--base)"
          }
        },
        ":focus": {
          "color": {
            "background": "var(--wp--preset--color--contrast)",
            "text": "var(--wp--preset--color--base)"
          }
        },
        ":active": {
          "color": {
            "background": "var(--wp--preset--color--secondary)",
            "text": "var(--wp--preset--color--base)"
          }
        },
        ":visited": {
          "color": {
            "text": "var(--wp--preset--color--contrast)"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "area": "header",
      "name": "header",
      "title": "Header"
    },
    {
      "area": "footer",
      "name": "footer",
      "title": "Footer"
    }
  ],
  "version": 3
}
