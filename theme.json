{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "customTemplates": [
    {
      "name": "blank",
      "title": "Blank",
      "postTypes": ["page", "post"]
    },
    {
      "name": "page-no-title",
      "title": "Page (No Title)",
      "postTypes": ["page"]
    }
  ],
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": true,
      "customDuotone": true,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "duotone": [
        {
          "colors": ["#000000", "#ffffff"],
          "name": "Black and white",
          "slug": "duotone-1"
        },
        {
          "colors": ["#36454F", "#E5E4E2"],
          "name": "Secondary and tertiary",
          "slug": "duotone-2"
        }
      ],
      "palette": [
        {
          "color": "#ffffff",
          "name": "Base",
          "slug": "base"
        },
        {
          "color": "#000000",
          "name": "Contrast",
          "slug": "contrast"
        },
        {
          "color": "#899499",
          "name": "Primary",
          "slug": "primary"
        },
        {
          "color": "#36454F",
          "name": "Secondary",
          "slug": "secondary"
        },
        {
          "color": "#E5E4E2",
          "name": "Tertiary",
          "slug": "tertiary"
        }
      ]
    },
    "custom": {
      "button": {
        "outline": {
          "borderWidth": "2px"
        }
      },
      "lineHeight": {
        "small": "1.2",
        "medium": "1.6",
        "large": "1.8"
      },
      "outline": {
        "width": "2px",
        "offset": "2px",
        "style": "solid"
      },
      "rule": "color-mix(in srgb, currentColor 25%, transparent)",
      "wash": "color-mix(in srgb, currentColor 6%, transparent)"
    },
    "layout": {
      "contentSize": "900px",
      "wideSize": "1200px"
    },
    "border": {
      "radius": true,
      "radiusSizes": [
        {
          "name": "None",
          "slug": "none",
          "size": "0"
        },
        {
          "name": "Small",
          "slug": "sm",
          "size": "0.25rem"
        },
        {
          "name": "Medium",
          "slug": "md",
          "size": "0.5rem"
        },
        {
          "name": "Large",
          "slug": "lg",
          "size": "1rem"
        },
        {
          "name": "Round",
          "slug": "round",
          "size": "9999px"
        }
      ]
    },
    "spacing": {
      "customSpacingSize": true,
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "name": "X-Small",
          "size": "0.5rem",
          "slug": "20"
        },
        {
          "name": "Small",
          "size": "1rem",
          "slug": "30"
        },
        {
          "name": "Medium",
          "size": "clamp(1rem, 4vw, 2rem)",
          "slug": "40"
        },
        {
          "name": "Large",
          "size": "clamp(2rem, 8vw, 4rem)",
          "slug": "50"
        },
        {
          "name": "X-Large",
          "size": "clamp(4rem, 10vw, 8rem)",
          "slug": "60"
        }
      ],
      "units": ["%", "px", "em", "rem", "vh", "vw"]
    },
    "typography": {
      "customFontSize": true,
      "defaultFontSizes": false,
      "dropCap": true,
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "\"Courier New\", Courier, \"Lucida Sans Typewriter\", \"Lucida Typewriter\", monospace",
          "name": "Courier New",
          "slug": "courier-new"
        },
        {
          "fontFamily": "Arial, \"Helvetica Neue\", Helvetica, sans-serif",
          "name": "Arial",
          "slug": "arial-helvetica"
        }
      ],
      "fontSizes": [
        {
          "fluid": false,
          "name": "Small",
          "size": "0.8rem",
          "slug": "small"
        },
        {
          "fluid": false,
          "name": "Base",
          "size": "1rem",
          "slug": "base"
        },
        {
          "fluid": {
            "min": "1.25rem",
            "max": "1.42rem"
          },
          "name": "Medium",
          "size": "1.42rem",
          "slug": "medium"
        },
        {
          "fluid": {
            "min": "1.56rem",
            "max": "1.89rem"
          },
          "name": "Large",
          "size": "1.89rem",
          "slug": "large"
        },
        {
          "fluid": {
            "min": "1.95rem",
            "max": "2.52rem"
          },
          "name": "X-Large",
          "size": "2.52rem",
          "slug": "x-large"
        },
        {
          "fluid": {
            "min": "2.44rem",
            "max": "3.35rem"
          },
          "name": "XX-Large",
          "size": "3.35rem",
          "slug": "xx-large"
        }
      ],
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textDecoration": true,
      "textTransform": true,
      "writingMode": true
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--30)",
      "padding": {
        "top": "0",
        "right": "var(--wp--preset--spacing--40)",
        "bottom": "0",
        "left": "var(--wp--preset--spacing--40)"
      }
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--courier-new)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "var(--wp--custom--line-height--medium)"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--arial-helvetica)",
          "fontWeight": "700",
          "lineHeight": "var(--wp--custom--line-height--small)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--base)"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "letterSpacing": "0.05em",
          "textTransform": "uppercase"
        }
      },
      "caption": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "lineHeight": "1.4"
        }
      },
      "cite": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "fontStyle": "normal"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--secondary)"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--contrast)"
          },
          "typography": {
            "textDecoration": "none"
          }
        },
        ":focus": {
          "typography": {
            "textDecoration": "underline dashed"
          }
        },
        ":active": {
          "color": {
            "text": "var(--wp--preset--color--secondary)"
          },
          "typography": {
            "textDecoration": "none"
          }
        }
      },
      "button": {
        "border": {
          "color": "var(--wp--preset--color--contrast)",
          "radius": "0",
          "style": "solid",
          "width": "0"
        },
        "color": {
          "background": "var(--wp--preset--color--secondary)",
          "text": "var(--wp--preset--color--base)"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "right": "1.25rem",
            "bottom": "0.75rem",
            "left": "1.25rem"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--arial-helvetica)",
          "fontSize": "var(--wp--preset--font-size--base)",
          "fontWeight": "700",
          "lineHeight": "var(--wp--custom--line-height--small)",
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--contrast)",
            "text": "var(--wp--preset--color--base)"
          }
        },
        ":focus": {
          "color": {
            "background": "var(--wp--preset--color--contrast)",
            "text": "var(--wp--preset--color--base)"
          },
          "outline": {
            "color": "var(--wp--preset--color--contrast)",
            "offset": "var(--wp--custom--outline--offset)",
            "style": "var(--wp--custom--outline--style)",
            "width": "var(--wp--custom--outline--width)"
          }
        },
        ":active": {
          "color": {
            "background": "var(--wp--preset--color--secondary)",
            "text": "var(--wp--preset--color--base)"
          }
        },
        ":visited": {
          "color": {
            "text": "var(--wp--preset--color--base)"
          }
        }
      },
      "label": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "fontWeight": "700"
        }
      },
      "textInput": {
        "border": {
          "color": "var(--wp--custom--rule)",
          "radius": "0",
          "style": "solid",
          "width": "1px"
        },
        "color": {
          "background": "var(--wp--preset--color--base)",
          "text": "var(--wp--preset--color--contrast)"
        },
        "spacing": {
          "padding": {
            "top": "0.5rem",
            "right": "0.75rem",
            "bottom": "0.5rem",
            "left": "0.75rem"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--courier-new)",
          "fontSize": "var(--wp--preset--font-size--base)"
        }
      },
      "select": {
        "border": {
          "color": "var(--wp--custom--rule)",
          "radius": "0",
          "style": "solid",
          "width": "1px"
        },
        "color": {
          "background": "var(--wp--preset--color--base)",
          "text": "var(--wp--preset--color--contrast)"
        },
        "spacing": {
          "padding": {
            "top": "0.5rem",
            "right": "0.75rem",
            "bottom": "0.5rem",
            "left": "0.75rem"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--courier-new)",
          "fontSize": "var(--wp--preset--font-size--base)"
        }
      }
    },
    "blocks": {
      "core/accordion": {
        "border": {
          "color": "var(--wp--custom--rule)",
          "style": "solid",
          "width": "0 0 1px"
        }
      },
      "core/accordion-heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--arial-helvetica)",
          "fontWeight": "700"
        },
        "border": {
          "color": "var(--wp--custom--rule)",
          "style": "solid",
          "width": "1px 0 0"
        },
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--20)",
            "bottom": "var(--wp--preset--spacing--20)"
          }
        }
      },
      "core/accordion-item": {
        "spacing": {
          "blockGap": "0"
        }
      },
      "core/archives": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        },
        "css": "&.wp-block-archives-list { list-style: none; padding-inline-start: 0; } &.wp-block-archives-list li { margin-block-start: 0.5rem; } & .wp-block-archives-dropdown select { max-width: 100%; }"
      },
      "core/audio": {
        "css": "& audio { width: 100%; }"
      },
      "core/avatar": {
        "border": {
          "radius": "var(--wp--preset--border-radius--round)"
        }
      },
      "core/button": {
        "variations": {
          "outline": {
            "border": {
              "color": "currentColor",
              "style": "solid",
              "width": "var(--wp--custom--button--outline--border-width)"
            },
            "color": {
              "background": "transparent"
            },
            "spacing": {
              "padding": {
                "top": "calc(0.75rem - var(--wp--custom--button--outline--border-width))",
                "right": "calc(1.25rem - var(--wp--custom--button--outline--border-width))",
                "bottom": "calc(0.75rem - var(--wp--custom--button--outline--border-width))",
                "left": "calc(1.25rem - var(--wp--custom--button--outline--border-width))"
              }
            },
            ":hover": {
              "color": {
                "background": "color-mix(in srgb, currentColor 12%, transparent)"
              }
            },
            ":focus": {
              "color": {
                "background": "color-mix(in srgb, currentColor 12%, transparent)"
              }
            }
          }
        }
      },
      "core/buttons": {
        "spacing": {
          "blockGap": "var(--wp--preset--spacing--30)"
        }
      },
      "core/calendar": {
        "css": "& table { border-collapse: collapse; } & table th, & table td { border: 1px solid var(--wp--custom--rule); padding: 0.25rem; text-align: center; } & table th { background-color: var(--wp--custom--wash); font-family: var(--wp--preset--font-family--arial-helvetica); font-weight: 700; } & table caption { font-family: var(--wp--preset--font-family--arial-helvetica); font-weight: 700; margin-block-end: 0.5rem; } & .wp-calendar-nav { display: flex; justify-content: space-between; margin-block-start: 0.5rem; font-size: var(--wp--preset--font-size--small); }"
      },
      "core/categories": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        },
        "css": "&.wp-block-categories-list { list-style: none; padding-inline-start: 0; } &.wp-block-categories-list li { margin-block-start: 0.5rem; } & .children { padding-inline-start: 1.5rem; } & .wp-block-categories__label { display: block; margin-block-end: 0.25rem; }"
      },
      "core/code": {
        "border": {
          "color": "var(--wp--custom--rule)",
          "radius": "0",
          "style": "solid",
          "width": "1px"
        },
        "color": {
          "background": "var(--wp--custom--wash)"
        },
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--30)",
            "right": "var(--wp--preset--spacing--30)",
            "bottom": "var(--wp--preset--spacing--30)",
            "left": "var(--wp--preset--spacing--30)"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--courier-new)",
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      },
      "core/columns": {
        "spacing": {
          "blockGap": "var(--wp--preset--spacing--40)"
        },
        "css": "&.has-background { padding: var(--wp--preset--spacing--40); }"
      },
      "core/comment-author-name": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--arial-helvetica)",
          "fontWeight": "700"
        }
      },
      "core/comment-content": {
        "color": {
          "background": "var(--wp--custom--wash)"
        },
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--30)",
            "right": "var(--wp--preset--spacing--30)",
            "bottom": "var(--wp--preset--spacing--30)",
            "left": "var(--wp--preset--spacing--30)"
          }
        },
        "css": "& > * { margin-block: 0.75rem 0; } & > :first-child { margin-block-start: 0; }"
      },
      "core/comment-date": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      },
      "core/comment-edit-link": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      },
      "core/comment-reply-link": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      },
      "core/comment-template": {
        "css": "& ol { margin-inline-start: var(--wp--preset--spacing--40); } & li { margin-block-end: 0; }"
      },
      "core/comments-pagination": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      },
      "core/comments-pagination-numbers": {
        "css": "& .page-numbers { padding: 0 0.25rem; } & .page-numbers.current { text-decoration: underline; text-underline-offset: 0.3em; }"
      },
      "core/comments-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--courier-new)",
          "fontSize": "var(--wp--preset--font-size--small)",
          "fontWeight": "400"
        }
      },
      "core/cover": {
        "css": "& .wp-block-cover__inner-container { --wp--custom--rule: color-mix(in srgb, currentColor 40%, transparent); }",
        "elements": {
          "heading": {
            "color": {
              "text": "inherit"
            }
          },
          "link": {
            "color": {
              "text": "inherit"
            },
            ":hover": {
              "color": {
                "text": "inherit"
              }
            }
          }
        }
      },
      "core/details": {
        "border": {
          "color": "var(--wp--custom--rule)",
          "style": "solid",
          "width": "1px 0"
        },
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--20)",
            "bottom": "var(--wp--preset--spacing--20)"
          }
        },
        "css": "& summary { font-family: var(--wp--preset--font-family--arial-helvetica); font-weight: 700; cursor: pointer; } & summary:hover { text-decoration: underline; } &[open] > summary { margin-block-end: var(--wp--preset--spacing--20); } & + .wp-block-details { border-top-width: 0; margin-block-start: 0; }"
      },
      "core/embed": {
        "css": "& figcaption { margin-block-start: 0.5rem; }"
      },
      "core/file": {
        "css": "& a:not(.wp-block-file__button) { font-family: var(--wp--preset--font-family--arial-helvetica); font-weight: 700; } & .wp-block-file__button { margin-inline-start: 1rem; }"
      },
      "core/footnotes": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        },
        "border": {
          "color": "var(--wp--custom--rule)",
          "style": "solid",
          "width": "1px 0 0"
        },
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--30)"
          }
        },
        "css": "& li { margin-block-start: 0.5rem; }"
      },
      "core/gallery": {
        "spacing": {
          "blockGap": "var(--wp--preset--spacing--30)"
        },
        "css": "& figcaption { margin-block-start: 0.5rem; }"
      },
      "core/group": {
        "css": "&.has-background { padding: var(--wp--preset--spacing--40); }"
      },
      "core/heading": {
        "css": "&.has-background { padding: 0.5rem 1rem; }"
      },
      "core/image": {
        "css": "& figcaption { text-align: left; margin-block-start: 0.5rem; } &.aligncenter figcaption { text-align: center; }"
      },
      "core/latest-comments": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        },
        "css": "& .wp-block-latest-comments__comment { margin-block-end: var(--wp--preset--spacing--30); } & .wp-block-latest-comments__comment-date { font-size: inherit; } & .wp-block-latest-comments__comment-excerpt p { font-size: inherit; margin: 0.25rem 0 0; }"
      },
      "core/latest-posts": {
        "css": "& li { margin-block-start: 0.5rem; } & .wp-block-latest-posts__post-date, & .wp-block-latest-posts__post-author { font-size: var(--wp--preset--font-size--small); } & .wp-block-latest-posts__post-excerpt, & .wp-block-latest-posts__post-full-content { margin-block: 0.25rem 0; } &.is-grid li { margin-block-start: 0; }"
      },
      "core/list": {
        "css": "& li { margin-block-start: 0.5rem; }"
      },
      "core/loginout": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      },
      "core/media-text": {
        "spacing": {
          "blockGap": "var(--wp--preset--spacing--40)"
        },
        "css": "& .wp-block-media-text__content { padding-inline: 0; }"
      },
      "core/navigation": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--arial-helvetica)",
          "fontStyle": "italic",
          "fontWeight": "700",
          "textTransform": "lowercase"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var(--wp--preset--color--contrast)"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      },
      "core/navigation-link": {
        "css": "&.current-menu-item > .wp-block-navigation-item__content, &.current-menu-ancestor > .wp-block-navigation-item__content { text-decoration: underline; }"
      },
      "core/page-list": {
        "css": "& li { margin-block-start: 0.5rem; } & .submenu-container, & ul { padding-inline-start: 1.5rem; }"
      },
      "core/paragraph": {
        "css": "&.has-background { padding: 0.5rem 1rem; }"
      },
      "core/post-author": {
        "css": "& .wp-block-post-author__avatar img { border-radius: var(--wp--preset--border-radius--round); } & .wp-block-post-author__byline { font-size: var(--wp--preset--font-size--small); } & .wp-block-post-author__name { font-family: var(--wp--preset--font-family--arial-helvetica); font-weight: 700; } & .wp-block-post-author__bio { font-size: var(--wp--preset--font-size--small); margin: 0.25rem 0 0; }"
      },
      "core/post-author-biography": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      },
      "core/post-author-name": {
        "elements": {
          "link": {
            "color": {
              "text": "var(--wp--preset--color--contrast)"
            }
          }
