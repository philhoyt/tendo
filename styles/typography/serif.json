{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Serif",
  "slug": "serif",
  "settings": {
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "Georgia, \"Iowan Old Style\", \"Palatino Linotype\", \"Times New Roman\", serif",
          "name": "Georgia",
          "slug": "georgia"
        },
        {
          "fontFamily": "Arial, \"Helvetica Neue\", Helvetica, sans-serif",
          "name": "Arial",
          "slug": "arial-helvetica"
        },
        {
          "fontFamily": "\"Courier New\", Courier, \"Lucida Sans Typewriter\", \"Lucida Typewriter\", monospace",
          "name": "Courier New",
          "slug": "courier-new"
        }
      ]
    }
  },
  "styles": {
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--georgia)",
      "lineHeight": "1.7"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--georgia)",
          "fontWeight": "700"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--georgia)"
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--georgia)"
        }
      },
      "core/query-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--georgia)"
        }
      },
      "core/pullquote": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--georgia)"
        }
      }
    }
  }
}
